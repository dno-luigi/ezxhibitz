{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezxhibitz",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true
  },
  // Static site: Vite builds into dist/, and Workers serves it directly.
  // Without this file, `wrangler deploy` falls back to framework auto-detection,
  // which fails to parse vite.config.js and aborts the deploy after the build.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // The API and shared packets are answered by the Worker; every other path is
    // a file in dist/ (or the SPA fallback).
    "run_worker_first": ["/api/*", "/f/*"]
  },

  // The D1 schema lives in migrations/0001_init.sql and is imported by the Worker
  // so a freshly provisioned database can be set up by the code itself.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // ── Own backend ───────────────────────────────────────────────────────────
  // Forms, share links and packet uploads stay in this Cloudflare account.
  //
  // No resource IDs on purpose: the build that runs on push uses this project's
  // wrangler (4.45+), which provisions the missing database and bucket itself and
  // links them to the Worker. Resource IDs written back by that build stay in the
  // build environment; leaving them out here keeps deploys repeatable from git.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ezxhibitz",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ezxhibitz-files" }]
}
