{
  "name": "exhibit-packet-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ezxhibitz --local --config wrangler.local.jsonc",
    "db:migrate": "wrangler d1 migrations apply ezxhibitz --remote"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.0",
    "clsx": "^2.1.1",
    "three": "^0.185.0",
    "@react-three/fiber": "^9.6.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.39.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "vite": "^7.0.0",
    "wrangler": "^4.158.0"
  }
}
